# Environment variables for recommendation service

# Database Configuration
DATABASE_URL=postgresql://rec_user:rec_password@localhost:5432/recommendation_db

# External Backend API (replace with your actual backend)
BACKEND_API_URL=http://localhost:8001/api
# BACKEND_API_TOKEN=your_api_token_here

# LLM Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-2.0-flash

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0
CACHE_EXPIRE_TIME=3600

# Service Configuration
DEBUG=true
SERVICE_NAME=recommendation-service

# Production Database (for production deployment)
# DB_HOST=your_db_host
# DB_PASSWORD=your_secure_password

# Production Settings
# BACKEND_API_URL=https://your-backend-api.com/api
# BACKEND_API_TOKEN=your_production_api_token