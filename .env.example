# ── mayda-ai environment ──
# Copy this file to .env and fill in your values.
# Every variable is read by src/core/config.py via pydantic-settings.

# ── Security (required in prod) ──
SERVICE_TOKEN=change-me-in-prod
GATEWAY_ORIGIN=http://localhost:3000

# ── Backend API (mayda-backend) ──
BACKEND_API_URL=http://host.docker.internal:8001
BACKEND_API_TIMEOUT=30

# ── LLM (recommendation engine) ──
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
# OPENAI_API_KEY=

# ── Database ──
# SQLite (dev): sqlite:///./data/inventory.db
# PostgreSQL (prod): postgresql://user:pass@host:5432/mayda
INVENTORY_DATABASE_URL=sqlite:///./data/inventory.db
INVENTORY_MODEL_PATH=data/models.joblib

# ── Vector Store ──
CHROMA_DB_DIR=chroma_db
CHROMA_COLLECTION_NAME=dishes

# ── Voice ──
WHISPER_MODEL=tiny

# ── Runtime ──
PORT=8101
LOG_LEVEL=INFO
