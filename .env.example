# ── Recommendation Service Environment ──

# Backend API (mayda-backend)
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TIMEOUT=30

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=

# Security
SERVICE_TOKEN=your-shared-service-token
GATEWAY_ORIGIN=http://localhost:3000

# Service
PORT=8101
LOG_LEVEL=INFO
