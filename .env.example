# ── mayda-ai shared environment ──
# Every variable listed here is read by the consolidated FastAPI app under
# `src/`. See docs/conventions/env-vars.md for the canonical contract.

# ── Security (required in prod) ──
SERVICE_TOKEN=change-me-in-prod
GATEWAY_ORIGIN=http://localhost:3000

# ── Backend API (mayda-backend) ──
BACKEND_API_URL=http://host.docker.internal:8001
BACKEND_API_TIMEOUT=30

# ── LLM (recommendation engine) ──
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=

# ── Voice ──
WHISPER_MODEL=tiny

# ── Runtime ──
PORT=8101
LOG_LEVEL=INFO
